# ===================================================================
# Adaptive Cyberattack Detection and Prevention System (Mini-SOC)
# Master Environment Variables Configuration (.env.example)
# ===================================================================

# -------------------------------------------------------------------
# 1. Frontend (React / Vite -> Netlify)
# -------------------------------------------------------------------
# In production, set to your deployed Java Spring Boot backend URL.
# In local development, leave unset to use Vite proxy (/api/v1 -> localhost:9090).
VITE_API_BASE_URL=https://soc-java-backend.onrender.com

# -------------------------------------------------------------------
# 2. Java Spring Boot Backend (Render / Docker)
# -------------------------------------------------------------------
PORT=9090
SOC_PYTHON_ML_URL=http://localhost:8000/api/v1
SOC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.netlify.app
H2_CONSOLE_ENABLED=false

# Optional PostgreSQL / Supabase Persistence:
# SPRING_PROFILES_ACTIVE=postgres
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_supabase_password

# -------------------------------------------------------------------
# 3. Python ML Inference Service (FastAPI -> Render / Docker)
# -------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false
ML_ARTIFACTS_DIR=../ml_engine/artifacts
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://*.netlify.app"]

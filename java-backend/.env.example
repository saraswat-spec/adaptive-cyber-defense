# Server Configuration
PORT=9090

# Database Configuration (Default: H2 in-memory; set for PostgreSQL/Supabase)
# SPRING_PROFILES_ACTIVE=postgres
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_supabase_db_password
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Python ML Microservice URL (FastAPI running on port 8000 or internal Render service)
SOC_PYTHON_ML_URL=http://localhost:8000/api/v1

# CORS Allowed Origins (Comma-separated list; includes Netlify domains)
SOC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.netlify.app

# Security & Console Configuration
H2_CONSOLE_ENABLED=false
